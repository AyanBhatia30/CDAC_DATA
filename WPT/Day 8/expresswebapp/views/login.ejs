
<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
</head>
<body>
    <h2>Login</h2>

  <!-- Display dynamic error message -->
<% if (typeof message !== 'undefined' && message) { %>
    <p style="color:red;"><%= message %></p>
<% } %>

    <form action="/login/validateuser" method="POST">
        <input type="username" name="uname"
               placeholder="username " required /><br><br>

        <input type="password" name="password"
               placeholder="Password" required /><br><br>

        <button type="submit" name="btn"
                id="login" value="login">Login</button>

        <button type="reset">Reset</button>
    </form>

    <p>Don't have an account?
       <a href="/login/register">Register</a></p>

    <p>Forgot password?
       <a href="/login/forgotpass">Forgot Password?</a></p>
</body>
</html>
